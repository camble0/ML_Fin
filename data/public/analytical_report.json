  "feature_transformations": [
    {
      "group": "household_context",
      "source_file": "CS_S01_S5_S7_Household.dta",
      "transformations": [
        {
          "original_variables": [
            "province",
            "district",
            "ur",
            "quintile"
          ],
          "resulting_features": [
            "province_code",
            "district_code",
            "urban_rural_code",
            "consumption_quintile"
          ],
          "transformation": "Retain Stata codes as categorical values; one-hot encode in the model."
        },
        {
          "original_variables": [
            "s5aq2",
            "s5aq7",
            "s5bq6",
            "s5cq3",
            "s5cq14",
            "s5cq20a",
            "s5cq25",
            "s7aq4"
          ],
          "resulting_features": [
            "dwelling_type_code",
            "dwelling_owner_code",
            "owns_residential_house",
            "drinking_water_source_code",
            "electricity_grid_connected",
            "internet_at_home",
            "toilet_type_code",
            "any_livestock"
          ],
          "transformation": "Retain interpretable dwelling, ownership, water, electricity, internet, toilet, and livestock response codes as categorical values."
        },
        {
          "original_variables": [
            "hhid",
            "clust",
            "strata_id",
            "weight",
            "pop_wt"
          ],
          "resulting_features": [
            "hhid",
            "clust",
            "strata_id",
            "weight",
            "pop_wt"
          ],
          "transformation": "Preserve identifiers/design fields in the table; never include these as model predictors. clust is used only for grouped splitting."
        }
      ]
    },
    {
      "group": "person_demographics_education_digital_work",
      "source_file": "CS_S0_S1_S2_S3_S4_S6A_S6B_S6C_Person.dta",
      "filter": "Keep rows with s1q14=1 (household membership Yes), then aggregate by hhid.",
      "transformations": [
        {
          "original_variables": [
            "pid"
          ],
          "resulting_features": [
            "resident_member_count"
          ],
          "transformation": "Count nonmissing resident person IDs per household."
        },
        {
          "original_variables": [
            "s1q3y"
          ],
          "resulting_features": [
            "mean_resident_age_years",
            "share_residents_age_15_64"
          ],
          "transformation": "Mean age and share aged 15-64 among members with age observed."
        },
        {
          "original_variables": [
            "s1q1"
          ],
          "resulting_features": [
            "share_female_residents"
          ],
          "transformation": "Fraction of known sex responses coded Female (2)."
        },
        {
          "original_variables": [
            "s4aq1",
            "s4bq8",
            "s4bq15"
          ],
          "resulting_features": [
            "share_residents_ever_attended_school",
            "share_residents_with_mobile_phone",
            "share_residents_using_internet"
          ],
          "transformation": "Within-household share of valid Yes (1) responses; denominator is nonmissing Yes/No responses."
        },
        {
          "original_variables": [
            "s6aq2",
            "s6aq5",
            "s6aq6"
          ],
          "resulting_features": [
            "share_residents_worked_own_farm",
            "share_residents_worked_nonfarm_wage",
            "share_residents_running_nonfarm_business"
          ],
          "transformation": "Within-household share of valid Yes (1) responses for each activity."
        }
      ]
    },
    {
      "group": "basic_service_access",
      "source_file": "CS_S5F_access_to_services.dta",
      "transformations": [
        {
          "original_variables": [
            "s5fq1"
          ],
          "resulting_features": [
            "access_service_use_often_share"
          ],
          "transformation": "Share of valid service items coded Often (3) or Regularly (4)."
        },
        {
          "original_variables": [
            "s5fq6",
            "s5fq7"
          ],
          "resulting_features": [
            "access_service_satisfied_share",
            "access_service_improving_share"
          ],
          "transformation": "Share of valid items coded Satisfied (1) and Improving (3), respectively."
        },
        {
          "original_variables": [
            "s5fq3a",
            "s5fq3b"
          ],
          "resulting_features": [
            "access_median_travel_time_minutes"
          ],
          "transformation": "Convert hours*60 + minutes only where both source components are present, then take household median."
        },
        {
          "original_variables": [
            "s5fq1"
          ],
          "resulting_features": [
            "access_service_item_count"
          ],
          "transformation": "Retain observed item count as a data-quality field; exclude from predictors."
        }
      ]
    },
    {
      "group": "credit_context",
      "source_file": "CS_S10A1_A2_credits.dta",
      "transformations": [
        {
          "original_variables": [
            "s10aq1"
          ],
          "resulting_features": [
            "household_any_loan_attempt"
          ],
          "transformation": "Per hhid, 1 if any valid row is Yes; 0 if valid responses exist and none is Yes; otherwise missing."
        },
        {
          "original_variables": [
            "s10aq3"
          ],
          "resulting_features": [
            "household_any_member_owes_money"
          ],
          "transformation": "Per hhid, 1 if any valid row is Yes; 0 if valid responses exist and none is Yes; otherwise missing."
        },
        {
          "original_variables": [
            "pid",
            "s10aq4"
          ],
          "resulting_features": [
            "credit_id_missing_row_count"
          ],
          "transformation": "Count records where both member and loan IDs are missing; retain responses by hhid and exclude this diagnostic count from predictors."
        }
      ]
    },
    {
      "group": "financial_inclusion_target",
      "source_file": "CS_S10C_Savings.dta",
      "transformations": [
        {
          "original_variables": [
            "s10cq4",
            "s10cq1"
          ],
          "resulting_features": [
            "hh_has_bank_or_momo_account",
            "target_source_status",
            "target_s10cq4_conflict"
          ],
          "transformation": "Use any s10cq4 Yes as household Yes; otherwise any s10cq4 No as No; if q4 is entirely unanswered and q1 is exclusively No, mark a structural No and label its source. Leave remaining unresolved cases missing. Mark households with both q4 codes for audit."
        }
      ]
    }
  ],
  "excluded_from_predictors": [
    {
      "variables": [
        "s10cq1",
        "s10cq4"
      ],
      "reason": "Direct target construction/source-screen questions; target provenance and conflict flags are also excluded."
    },
    {
      "variables": [
        "s10cq3",
        "s10cq5",
        "s10cq6",
        "s10cq7",
        "s10cq8",
        "pid"
      ],
      "reason": "Account IDs or account/tontine details from the target module; not loaded as predictors to avoid target-adjacent leakage."
    },
    {
      "variables": [
        "hhid",
        "clust",
        "strata_id",
        "weight",
        "pop_wt"
      ],
      "reason": "Identifiers, split groups, and preserved survey-design fields; not model predictors."
    },
    {
      "variables": [
        "s10aq2",
        "s10aq4",
        "s10aq6",
        "s10aq7",
        "s10aq8",
        "s10aq9"
      ],
      "reason": "Loan denial/source/purpose/collateral/repayment details are excluded from the initial feature set; several are conditional or post-loan details."
    },
    {
      "variables": [
        "s9d5q1-s9d5q7"
      ],
      "reason": "VUP-specific financial-loan module was not selected as a general inclusion predictor or target because it is sparse and program-specific."
    }
  ],
  "credit_feature_caveat": "Aggregated credit indicators are contemporaneous financial behaviors, not causes. They do not directly define the bank/Momo target but may act as adjacent financial-inclusion proxies; interpret model scores accordingly.",
